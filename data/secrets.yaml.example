---
# Copy to data/secrets.yaml ON THE SERVER (it is gitignored) and set real
# values. db_password is wrapped in Sensitive via lookup_options in
# common.yaml; override_options deep-merges over common.yaml's.
mattermost::db_password: 'CHANGE-ME-long-random-string'

mattermost::override_options:
  EmailSettings:
    SMTPPassword: 'CHANGE-ME-mailbox-password'
